<vbox width="100%" height="100%" style="padding: 12px 20px; spacing: 8px;">
	<hbox width="100%" style="spacing: 8px;">
		<button id="muteButton" />
		<button id="newChatButton" />
		<button id="optionsButton" />
		<button id="gamesButton" />
		<button id="boostButton" />
		<button id="debugButton" text="DBG" styleName="danger" hidden="true" />
		<spacer width="100%" />
		<label id="devWatermark" styleName="dev-watermark" hidden="true" verticalAlign="center" />
		<label id="statusLabel" styleName="status-offline" verticalAlign="center" />
	</hbox>
	<label id="titleLabel" styleName="title" horizontalAlign="center" />
	<spacer id="avatarSpacer" width="70" height="70" horizontalAlign="center" />
	<label id="thinkingLabel" styleName="muted" horizontalAlign="center" />
	<scrollview id="historyScroll" width="100%" height="100%" contentWidth="100%" styleName="panel">
		<vbox id="historyList" width="100%" style="spacing: 6px;" />
	</scrollview>
	<hbox width="100%">
		<label id="commandHintLabel" styleName="muted" width="100%" />
		<label id="charCounterLabel" styleName="muted" />
	</hbox>
	<hbox width="100%" style="spacing: 10px;">
		<textfield id="inputField" width="100%" />
		<button id="sendButton" styleName="primary" />
	</hbox>
	<label id="versionLabel" styleName="muted" horizontalAlign="right" />
</vbox>
