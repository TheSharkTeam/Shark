import hxp.*;
import lime.tools.*;
import haxe.Json;
import haxe.io.Path;
import haxe.io.Bytes;
import haxe.crypto.Md5;
import sys.FileSystem;
import sys.io.File;
import sys.net.Socket;
import sys.net.Host;
import sys.ssl.Socket as SSLSocket;

class Project extends HXProject
{
	static inline var APP_TITLE:String = "Shark";
	static inline var APP_PACKAGE:String = "com.brenninho.shark";
	static inline var APP_VERSION:String = "0.1.0";
	static inline var APP_COMPANY:String = "Brenninho";
	static inline var DEV_BRANCH_NAME:String = "dev";
	static inline var STAGING_BRANCH_NAME:String = "staging";
	static inline var MAIN_BRANCH_NAME:String = "main";
	static inline var ASTC_WARN_THRESHOLD_BYTES:Int = 400000;
	static inline var ASSET_WARN_THRESHOLD_BYTES:Int = 250000000;

	static var PLACEHOLDER_PATTERNS:Array<String> = ["YOUR_API_KEY", "CHANGE_ME", "REPLACE_ME", "TODO", "XXXXXXXX", "INSERT_KEY_HERE", "SECRET_HERE"];

	static var KNOWN_LICENSES:Map<String, String> = [
		"lime" => "MIT",
		"openfl" => "MIT",
		"flixel" => "MIT",
		"flixel-addons" => "MIT",
		"flixel-ui" => "MIT",
		"hscript" => "MIT",
		"SScript" => "MIT",
		"polymod" => "MIT",
		"hxvlc" => "MIT",
		"hxdiscord_rpc" => "MIT",
		"hxmath" => "MIT",
		"newgrounds" => "MIT",
		"astc-compressor" => "MIT",
		"flxanimate" => "MIT",
		"extension-androidtools" => "MIT",
		"hxgamemode" => "MIT",
		"sentry" => "BSD-3-Clause",
		"munit" => "MIT",
		"mconsole" => "MIT",
		"mcover" => "MIT",
		"flixel-demos" => "MIT"
	];

	static var ALLOWED_LICENSES:Array<String> = ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "zlib", "Unlicense", "ISC"];

	var isDevBranch:Bool;
	var isStagingBranch:Bool;
	var isMainBranch:Bool;
	var gitBranch:String;
	var isGitAvailable:Bool = true;
	var sharkEnvironment:String;
	var envVars:Map<String, String> = new Map();
	var cliArgs:Map<String, String> = new Map();
	var cliFlags:Array<String> = [];
	var activeFeatures:Array<String> = [];
	var buildWarnings:Array<String> = [];
	var buildStartTime:Float;
	var buildPhases:Array<{phase:String, ms:Float}> = [];

	public function new()
	{
		super();

		buildStartTime = Sys.time();

		#if (haxe_ver < 4.3)
		Log.warn('Haxe version is older than 4.3 - this project is built and tested against 4.3.7.');
		#end

		parseCliArgs();
		loadEnvFile();
		recordBuildPhase("env_loaded");

		gitBranch = resolveGitBranch();
		isDevBranch = gitBranch == DEV_BRANCH_NAME;
		isStagingBranch = gitBranch == STAGING_BRANCH_NAME;
		isMainBranch = gitBranch == MAIN_BRANCH_NAME;
		sharkEnvironment = resolveEnvironment();
		recordBuildPhase("environment_resolved");

		setupMeta();
		setupApp();
		setupWindow();
		setupSource();
		setupHaxelibs();
		recordBuildPhase("haxelibs_configured");

		setupAssets();
		setupIcon();
		setupLocalization();
		setupFeatureFlags();
		setupDefines();
		setupOptimizations();
		recordBuildPhase("assets_and_defines_configured");

		if (!cliFlag("skip-validation"))
		{
			checkConfigJson();
			checkDependencyIntegrity();
			validateHmmAlignment();
			validateAssetIntegrity();
			checkLocalizationCompleteness();
			validateLicenses();
			testEndpointConnectivity();
			writeThirdPartyNotices();
		}
		else
		{
			buildWarnings.push("Validation phase skipped (--skip-validation) - warnings from that phase were not collected.");
		}

		if (!debug || envOr("SHARK_FORCE_ASSET_MANIFEST", "") == "1")
			processAssetManifest();

		recordBuildPhase("validation_complete");

		switch (target)
		{
			case WINDOWS:
				setupWindows();
			case ANDROID:
				setupAndroid();
			case IOS:
				setupIOS();
			case HTML5:
				setupHTML5();
			case LINUX:
				setupLinux();
			case MAC:
				setupMac();
			default:
				buildWarnings.push('Unrecognized target "$target" - no platform-specific setup applied.');
		}

		recordBuildPhase("platform_configured");

		setupDevMode();
		setupStagingMode();
		setupProductionMode();
		recordBuildPhase("environment_mode_configured");

		generateChangelogEntry();
		syncReadmeVersionBadge();
		writePostBuildHooks();
		writeBuildInfo();
		writeBuildReport();
		maybeCreateGitTag();
		recordBuildPhase("post_processing_complete");

		logBuildSummary();
		sendDiscordNotification(buildSummaryMessage());
	}

	function recordBuildPhase(phase:String):Void
	{
		buildPhases.push({phase: phase, ms: (Sys.time() - buildStartTime) * 1000});
	}

	function parseCliArgs():Void
	{
		for (arg in Sys.args())
		{
			if (!StringTools.startsWith(arg, "--"))
				continue;

			var stripped:String = arg.substr(2);
			var equalsIndex:Int = stripped.indexOf("=");

			if (equalsIndex == -1)
			{
				cliFlags.push(stripped);
				continue;
			}

			var key:String = stripped.substr(0, equalsIndex);
			var value:String = stripped.substr(equalsIndex + 1);
			cliArgs.set(key, value);
		}
	}

	function cliFlag(name:String):Bool
	{
		return cliFlags.indexOf(name) != -1;
	}

	function cliOr(name:String, fallback:String):String
	{
		return cliArgs.exists(name) ? cliArgs.get(name) : fallback;
	}

	function loadEnvFile():Void
	{
		var candidates:Array<String> = [".env", ".env.local"];

		for (path in candidates)
		{
			if (!FileSystem.exists(path))
				continue;

			try
			{
				var lines:Array<String> = File.getContent(path).split("\n");

				for (rawLine in lines)
				{
					var line:String = StringTools.trim(rawLine);

					if (line.length == 0 || StringTools.startsWith(line, "#"))
						continue;

					var separatorIndex:Int = line.indexOf("=");

					if (separatorIndex == -1)
						continue;

					var key:String = StringTools.trim(line.substr(0, separatorIndex));
					var value:String = StringTools.trim(line.substr(separatorIndex + 1));

					if (value.length >= 2 && StringTools.startsWith(value, "\"") && StringTools.endsWith(value, "\""))
						value = value.substr(1, value.length - 2);

					envVars.set(key, value);
				}
			}
			catch (e:Dynamic)
			{
				buildWarnings.push('Failed to parse $path - ignoring it.');
			}
		}
	}

	function envOr(name:String, fallback:String):String
	{
		var cliKey:String = name.toLowerCase().split("_").join("-");

		if (cliArgs.exists(cliKey))
			return cliArgs.get(cliKey);

		var systemValue:String = Sys.getEnv(name);

		if (systemValue != null && systemValue.length > 0)
			return systemValue;

		if (envVars.exists(name))
		{
			var localValue:String = envVars.get(name);

			if (localValue != null && localValue.length > 0)
				return localValue;
		}

		return fallback;
	}

	function resolveEnvironment():String
	{
		var explicit:String = envOr("SHARK_ENV", "");

		if (explicit == "dev" || explicit == "staging" || explicit == "production")
			return explicit;

		if (isMainBranch)
			return "production";

		if (isStagingBranch)
			return "staging";

		return "dev";
	}

	function checkConfigJson():Void
	{
		var path:String = "assets/data/config.json";

		if (!FileSystem.exists(path))
		{
			buildWarnings.push('$path not found - copy the placeholder config (see .github/actions/ensure-config) or the chat/image API will not be configured.');
			return;
		}

		try
		{
			var parsed:Dynamic = Json.parse(File.getContent(path));
			var knownSections:Array<String> = ["network", "chat", "api", "image", "audio", "security", "connectivity", "app", "discord", "platforms", "servers", "schemaVersion"];
			var unknownSections:Array<String> = [];

			for (field in Reflect.fields(parsed))
				if (knownSections.indexOf(field) == -1)
					unknownSections.push(field);

			if (unknownSections.length > 0)
				buildWarnings.push('$path has unrecognized top-level section(s): ${unknownSections.join(", ")} - check for typos.');

			checkConfigSchemaVersion(parsed);

			if (!Reflect.hasField(parsed, "network"))
			{
				buildWarnings.push('$path is missing the "network" section entirely - chat/image API will not be configured.');
				return;
			}

			var network:Dynamic = Reflect.field(parsed, "network");
			var requiredNetworkFields:Array<String> = ["chatEndpoint", "chatApiKey", "imageEndpoint", "imageApiKey", "requireOnline"];

			for (field in requiredNetworkFields)
				if (!Reflect.hasField(network, field))
					buildWarnings.push('$path "network" section is missing field "$field".');

			if (!debug && Reflect.hasField(network, "chatEndpoint") && StringTools.trim(Std.string(Reflect.field(network, "chatEndpoint"))).length == 0)
				buildWarnings.push('$path network.chatEndpoint is empty in a release build - chat will stay unconfigured until the user sets it, or requireOnline blocks it.');

			checkApiKeyPlaceholders(network);
		}
		catch (e:Dynamic)
		{
			buildWarnings.push('$path exists but is not valid JSON - the chat/image API may fail to configure at runtime.');
		}
	}

	function checkConfigSchemaVersion(parsed:Dynamic):Void
	{
		var CURRENT_SCHEMA_VERSION:Int = 2;

		if (!Reflect.hasField(parsed, "schemaVersion"))
		{
			buildWarnings.push('config.json has no "schemaVersion" field - assuming version 1 (legacy). Add "schemaVersion": $CURRENT_SCHEMA_VERSION to silence this warning.');
			return;
		}

		var version:Null<Int> = Std.parseInt(Std.string(Reflect.field(parsed, "schemaVersion")));

		if (version == null)
		{
			buildWarnings.push('config.json "schemaVersion" is not a valid integer.');
			return;
		}

		if (version < CURRENT_SCHEMA_VERSION)
			buildWarnings.push('config.json schemaVersion ($version) is older than the current schema ($CURRENT_SCHEMA_VERSION) - some fields may be interpreted with legacy defaults.');
		else if (version > CURRENT_SCHEMA_VERSION)
			buildWarnings.push('config.json schemaVersion ($version) is newer than this build script understands ($CURRENT_SCHEMA_VERSION) - update Project.hxp.');
	}

	function checkApiKeyPlaceholders(network:Dynamic):Void
	{
		var keyFields:Array<String> = ["chatApiKey", "imageApiKey"];

		for (field in keyFields)
		{
			if (!Reflect.hasField(network, field))
				continue;

			var value:String = Std.string(Reflect.field(network, field)).toUpperCase();

			for (pattern in PLACEHOLDER_PATTERNS)
			{
				if (value.indexOf(pattern) != -1)
				{
					buildWarnings.push('config.json network.$field looks like a placeholder value - replace it with a real key before shipping a non-dev build.');
					break;
				}
			}
		}
	}

	function configHasChatEndpoint():Bool
	{
		var path:String = "assets/data/config.json";

		if (!FileSystem.exists(path))
			return false;

		try
		{
			var parsed:Dynamic = Json.parse(File.getContent(path));
			var network:Dynamic = Reflect.field(parsed, "network");

			if (network == null)
				return false;

			var endpoint:Dynamic = Reflect.field(network, "chatEndpoint");
			return endpoint != null && StringTools.trim(Std.string(endpoint)).length > 0;
		}
		catch (e:Dynamic)
		{
			return false;
		}
	}

	function testEndpointConnectivity():Void
	{
		if (envOr("SHARK_CHECK_CONNECTIVITY", "0") != "1")
			return;

		var path:String = "assets/data/config.json";

		if (!FileSystem.exists(path))
			return;

		try
		{
			var parsed:Dynamic = Json.parse(File.getContent(path));
			var network:Dynamic = Reflect.field(parsed, "network");

			if (network == null)
				return;

			checkEndpointReachable("chatEndpoint", Reflect.field(network, "chatEndpoint"));
			checkEndpointReachable("imageEndpoint", Reflect.field(network, "imageEndpoint"));
		}
		catch (e:Dynamic) {}
	}

	function checkEndpointReachable(label:String, endpoint:Dynamic):Void
	{
		if (endpoint == null)
			return;

		var url:String = Std.string(endpoint);

		if (StringTools.trim(url).length == 0)
			return;

		try
		{
			var parsedUrl = parseUrl(url);
			var socket = new Socket();
			socket.setTimeout(3.0);
			socket.connect(new Host(parsedUrl.host), parsedUrl.port);
			socket.close();
			activeFeatures.push('$label reachable (${parsedUrl.host}:${parsedUrl.port})');
		}
		catch (e:Dynamic)
		{
			buildWarnings.push('$label ("$url") could not be reached during setup - the app may fail to connect at runtime if this persists.');
		}
	}

	function parseUrl(url:String):{scheme:String, host:String, port:Int, path:String}
	{
		var scheme:String = "https";
		var rest:String = url;
		var schemeIndex:Int = url.indexOf("://");

		if (schemeIndex != -1)
		{
			scheme = url.substr(0, schemeIndex);
			rest = url.substr(schemeIndex + 3);
		}

		var path:String = "/";
		var pathIndex:Int = rest.indexOf("/");

		if (pathIndex != -1)
		{
			path = rest.substr(pathIndex);
			rest = rest.substr(0, pathIndex);
		}

		var port:Int = scheme == "https" ? 443 : 80;
		var host:String = rest;
		var portIndex:Int = rest.indexOf(":");

		if (portIndex != -1)
		{
			host = rest.substr(0, portIndex);
			port = Std.parseInt(rest.substr(portIndex + 1));
		}

		return {scheme: scheme, host: host, port: port, path: path};
	}

	function checkDependencyIntegrity():Void
	{
		var required:Array<String> = ["lime", "openfl", "flixel", "flixel-addons", "hscript", "polymod"];
		var missing:Array<String> = [];

		try
		{
			var process = new sys.io.Process("haxelib", ["list"]);
			var output:String = process.stdout.readAll().toString();
			process.close();

			for (lib in required)
				if (output.indexOf(lib) == -1)
					missing.push(lib);
		}
		catch (e:Dynamic)
		{
			buildWarnings.push("Could not run `haxelib list` to verify installed dependencies - skipping integrity check.");
			return;
		}

		if (missing.length > 0)
			buildWarnings.push('The following haxelibs appear to be missing locally: ${missing.join(", ")} - run `haxelib install <name>`.');
	}

	function validateLicenses():Void
	{
		for (lib in haxelibs)
		{
			if (!KNOWN_LICENSES.exists(lib.name))
			{
				buildWarnings.push('No known license recorded for haxelib "${lib.name}" - verify its license manually before distributing Shark.');
				continue;
			}

			var license:String = KNOWN_LICENSES.get(lib.name);

			if (ALLOWED_LICENSES.indexOf(license) == -1)
				buildWarnings.push('haxelib "${lib.name}" uses license "$license", which is not on the approved list (${ALLOWED_LICENSES.join(", ")}) - review before distribution.');
		}
	}

	function validateHmmAlignment():Void
	{
		if (!FileSystem.exists("hmm.json"))
			return;

		try
		{
			var parsed:Dynamic = Json.parse(File.getContent("hmm.json"));
			var dependencies:Array<Dynamic> = Reflect.field(parsed, "dependencies");

			if (dependencies == null)
				return;

			var hmmNames:Array<String> = [];

			for (dep in dependencies)
			{
				var name:String = Reflect.field(dep, "name");

				if (name != null)
					hmmNames.push(name);
			}

			var referencedNames:Array<String> = [for (lib in haxelibs) lib.name];
			var missingFromHmm:Array<String> = [];

			for (lib in referencedNames)
				if (hmmNames.indexOf(lib) == -1 && missingFromHmm.indexOf(lib) == -1)
					missingFromHmm.push(lib);

			if (missingFromHmm.length > 0)
				buildWarnings.push('Project.hxp references haxelib(s) not listed in hmm.json: ${missingFromHmm.join(", ")} - CI will not install them, and the build will fail with "Type not found" errors.');

			var unusedInHmm:Int = 0;

			for (name in hmmNames)
				if (referencedNames.indexOf(name) == -1)
					unusedInHmm++;

			if (unusedInHmm > 0)
				Log.info('$unusedInHmm haxelib(s) in hmm.json are not referenced by Project.hxp (fine for build-only tools like hxp/hxcpp, or git-based forks not yet wired up).');
		}
		catch (e:Dynamic)
		{
			buildWarnings.push("hmm.json exists but could not be parsed for alignment checking.");
		}
	}

	function validateAssetIntegrity():Void
	{
		if (!FileSystem.exists("assets/images/icon.png"))
			buildWarnings.push("assets/images/icon.png not found - the app icon will fail to package.");

		if (!FileSystem.exists("assets/images") || !FileSystem.isDirectory("assets/images") || FileSystem.readDirectory("assets/images").length == 0)
		{
			buildWarnings.push("assets/images is missing or empty.");
			return;
		}

		var totalSize:Int = 0;
		var uncompressedLargeTextures:Array<String> = [];
		var nonPowerOfTwoTextures:Array<String> = [];

		scanDirectory("assets/images", function(fullPath:String, size:Int)
		{
			totalSize += size;

			if (!StringTools.endsWith(fullPath, ".png"))
				return;

			if (size > ASTC_WARN_THRESHOLD_BYTES && (target == ANDROID || target == IOS))
				uncompressedLargeTextures.push(fullPath);

			var dimensions = readPngDimensions(fullPath);

			if (dimensions != null && (target == ANDROID || target == IOS) && (!isPowerOfTwo(dimensions.width) || !isPowerOfTwo(dimensions.height)))
				nonPowerOfTwoTextures.push('$fullPath (${dimensions.width}x${dimensions.height})');
		});

		if (totalSize > ASSET_WARN_THRESHOLD_BYTES)
			buildWarnings.push('assets/images totals ${formatBytes(totalSize)}, which is unusually large - consider trimming unused assets.');

		if (uncompressedLargeTextures.length > 0)
			buildWarnings.push('${uncompressedLargeTextures.length} texture(s) over ${formatBytes(ASTC_WARN_THRESHOLD_BYTES)} are still raw PNG for a mobile target - the astc-compressor haxelib is available for this, consider wiring it up: ${uncompressedLargeTextures.join(", ")}');

		if (nonPowerOfTwoTextures.length > 0)
			buildWarnings.push('${nonPowerOfTwoTextures.length} texture(s) are not power-of-two dimensions on a mobile target - mipmapping and some ASTC block modes may be less efficient: ${nonPowerOfTwoTextures.join(", ")}');
	}

	function readPngDimensions(path:String):{width:Int, height:Int}
	{
		try
		{
			var bytes:Bytes = File.getBytes(path);

			if (bytes.length < 24)
				return null;

			var signatureValid:Bool = bytes.get(0) == 0x89 && bytes.get(1) == 0x50 && bytes.get(2) == 0x4E && bytes.get(3) == 0x47;

			if (!signatureValid)
				return null;

			var width:Int = (bytes.get(16) << 24) | (bytes.get(17) << 16) | (bytes.get(18) << 8) | bytes.get(19);
			var height:Int = (bytes.get(20) << 24) | (bytes.get(21) << 16) | (bytes.get(22) << 8) | bytes.get(23);

			return {width: width, height: height};
		}
		catch (e:Dynamic)
		{
			return null;
		}
	}

	function isPowerOfTwo(value:Int):Bool
	{
		return value > 0 && (value & (value - 1)) == 0;
	}

	function scanDirectory(path:String, onFile:String->Int->Void):Void
	{
		if (!FileSystem.exists(path))
			return;

		for (entry in FileSystem.readDirectory(path))
		{
			var fullPath:String = '$path/$entry';

			if (FileSystem.isDirectory(fullPath))
			{
				scanDirectory(fullPath, onFile);
				continue;
			}

			try
			{
				onFile(fullPath, FileSystem.stat(fullPath).size);
			}
			catch (e:Dynamic) {}
		}
	}

	function processAssetManifest():Void
	{
		var manifest:Array<{path:String, size:Int, checksum:String}> = [];
		var skipPaths:Array<String> = ["assets/data/asset_manifest.json", "assets/data/build_info.json"];

		scanDirectory("assets", function(path:String, size:Int):Void
		{
			if (skipPaths.indexOf(path) != -1)
				return;

			try
			{
				manifest.push({path: path, size: size, checksum: Md5.make(File.getBytes(path)).toHex()});
			}
			catch (e:Dynamic) {}
		});

		var combinedHash:String = computeCombinedHash(manifest);

		if (isAssetCacheHit(combinedHash))
		{
			activeFeatures.push('Asset manifest unchanged (${manifest.length} file(s), cache hit) - skipped rewrite');
			return;
		}

		writeAssetManifestFile(manifest);
		checkForDuplicateAssets(manifest);
		writeAssetCacheHash(combinedHash);
	}

	function computeCombinedHash(manifest:Array<{path:String, size:Int, checksum:String}>):String
	{
		var sorted:Array<{path:String, size:Int, checksum:String}> = manifest.copy();
		sorted.sort(function(a, b) return a.path < b.path ? -1 : (a.path > b.path ? 1 : 0));

		var combined:StringBuf = new StringBuf();

		for (entry in sorted)
			combined.add('${entry.path}:${entry.checksum};');

		return Md5.encode(combined.toString());
	}

	function isAssetCacheHit(hash:String):Bool
	{
		var cachePath:String = ".shark_asset_cache";

		if (!FileSystem.exists(cachePath))
			return false;

		try
		{
			return StringTools.trim(File.getContent(cachePath)) == hash;
		}
		catch (e:Dynamic)
		{
			return false;
		}
	}

	function writeAssetCacheHash(hash:String):Void
	{
		try
		{
			File.saveContent(".shark_asset_cache", hash);
		}
		catch (e:Dynamic) {}
	}

	function writeAssetManifestFile(manifest:Array<{path:String, size:Int, checksum:String}>):Void
	{
		try
		{
			if (!FileSystem.exists("assets/data"))
				FileSystem.createDirectory("assets/data");

			File.saveContent("assets/data/asset_manifest.json", Json.stringify(manifest, null, "\t"));
			activeFeatures.push('Asset manifest (${manifest.length} file(s))');
		}
		catch (e:Dynamic)
		{
			buildWarnings.push("Failed to write assets/data/asset_manifest.json.");
		}
	}

	function checkForDuplicateAssets(manifest:Array<{path:String, size:Int, checksum:String}>):Void
	{
		var byChecksum:Map<String, Array<String>> = new Map();

		for (entry in manifest)
		{
			if (!byChecksum.exists(entry.checksum))
				byChecksum.set(entry.checksum, []);

			byChecksum.get(entry.checksum).push(entry.path);
		}

		var duplicateGroups:Int = 0;

		for (checksum => paths in byChecksum)
		{
			if (paths.length <= 1)
				continue;

			duplicateGroups++;
			buildWarnings.push('Duplicate asset content across ${paths.length} files: ${paths.join(", ")}');
		}

		if (duplicateGroups > 0)
			Log.info('$duplicateGroups group(s) of duplicate asset content found - see warnings above.');
	}

	function checkLocalizationCompleteness():Void
	{
		var localesPath:String = "assets/data/locales";

		if (!FileSystem.exists(localesPath) || !FileSystem.isDirectory(localesPath))
			return;

		var referenceKey:String = "en";
		var referencePath:String = '$localesPath/$referenceKey.json';

		if (!FileSystem.exists(referencePath))
			return;

		var referenceKeys:Array<String>;

		try
		{
			referenceKeys = Reflect.fields(Json.parse(File.getContent(referencePath)));
		}
		catch (e:Dynamic)
		{
			buildWarnings.push('Could not parse $referencePath for localization completeness checking.');
			return;
		}

		for (entry in FileSystem.readDirectory(localesPath))
		{
			if (!StringTools.endsWith(entry, ".json") || entry == '$referenceKey.json')
				continue;

			var localeCode:String = entry.substr(0, entry.length - 5);
			var localePath:String = '$localesPath/$entry';

			try
			{
				var localeKeys:Array<String> = Reflect.fields(Json.parse(File.getContent(localePath)));
				var missing:Array<String> = [];

				for (key in referenceKeys)
					if (localeKeys.indexOf(key) == -1)
						missing.push(key);

				if (missing.length > 0)
					buildWarnings.push('Locale "$localeCode" is missing ${missing.length} key(s) from "$referenceKey": ${missing.join(", ")}');
			}
			catch (e:Dynamic)
			{
				buildWarnings.push('Locale "$localeCode" has invalid JSON.');
			}
		}
	}

	function writeThirdPartyNotices():Void
	{
		var pinned:Map<String, String> = loadPinnedVersions();
		var lines:Array<String> = ["Shark - Third-Party Notices", "", 'Generated: ${Date.now().toString()}', ""];

		for (lib in haxelibs)
		{
			var version:String = pinned.exists(lib.name) ? pinned.get(lib.name) : "latest";
			var license:String = KNOWN_LICENSES.exists(lib.name) ? KNOWN_LICENSES.get(lib.name) : "unknown";
			lines.push('- ${lib.name} ($version) - $license');
		}

		try
		{
			File.saveContent("THIRD_PARTY_NOTICES.txt", lines.join("\n"));
		}
		catch (e:Dynamic) {}
	}

	function formatDecimal(value:Float, decimals:Int):String
	{
		var factor:Float = Math.pow(10, decimals);
		var rounded:Float = Math.round(value * factor) / factor;
		var text:String = Std.string(rounded);

		if (text.indexOf(".") == -1)
			text += ".0";

		return text;
	}

	function formatBytes(bytes:Int):String
	{
		if (bytes >= 1000000)
			return formatDecimal(bytes / 1000000, 2) + " MB";

		if (bytes >= 1000)
			return formatDecimal(bytes / 1000, 2) + " KB";

		return '$bytes B';
	}

	function formatDate(date:Date):String
	{
		var month:String = StringTools.lpad(Std.string(date.getMonth() + 1), "0", 2);
		var day:String = StringTools.lpad(Std.string(date.getDate()), "0", 2);
		return '${date.getFullYear()}-$month-$day';
	}

	function buildSummaryMessage():String
	{
		var status:String = buildWarnings.length == 0 ? "clean" : '${buildWarnings.length} warning(s)';
		return 'Shark ${meta.version} build (build ${meta.buildNumber}) for $target finished - $status. Branch: $gitBranch, environment: $sharkEnvironment.';
	}

	function logBuildSummary():Void
	{
		var devTag:String = isDevBranch ? " [DEV BRANCH]" : "";
		var elapsed:Float = Sys.time() - buildStartTime;

		Log.info('Shark ${meta.version} (build ${meta.buildNumber}, commit ${haxedefs.get("SHARK_COMMIT")}, branch $gitBranch, env $sharkEnvironment) -> $target, ${debug ? "debug" : "release"}$devTag');

		if (!isGitAvailable)
			Log.warn("git was not found or this is not a git repository - commit hash, branch, and tag/working-tree checks fell back to defaults.");

		if (activeFeatures.length > 0)
			Log.info('Active optional features for this build: ${activeFeatures.join(", ")}');

		if (buildWarnings.length > 0)
		{
			Log.warn('${buildWarnings.length} warning(s) collected during project setup:');

			for (warning in buildWarnings)
				Log.warn('  - $warning');
		}

		Log.info('Project.hxp setup finished in ${formatDecimal(elapsed, 3)}s');
	}

	function setupMeta():Void
	{
		meta.title = APP_TITLE;
		meta.description = "An artificial intelligence made with HaxeFlixel.";
		meta.packageName = APP_PACKAGE;
		meta.version = resolveVersion();
		meta.company = APP_COMPANY;
		meta.buildNumber = resolveBuildNumber();
	}

	function resolveVersion():String
	{
		if (cliArgs.exists("version"))
			return cliArgs.get("version");

		if (FileSystem.exists("VERSION"))
		{
			var content:String = StringTools.trim(File.getContent("VERSION"));

			if (content.length > 0)
			{
				if (!isValidVersionFormat(content))
					buildWarnings.push('VERSION file contains "$content", which does not look like a semver string (e.g. 1.2.3) - using it anyway.');

				return content;
			}
		}

		return APP_VERSION;
	}

	function isValidVersionFormat(value:String):Bool
	{
		var parts:Array<String> = value.split(".");

		if (parts.length < 2 || parts.length > 3)
			return false;

		for (part in parts)
			if (Std.parseInt(part) == null)
				return false;

		return true;
	}

	function setupApp():Void
	{
		app.main = "Main";
		app.file = APP_TITLE;
		app.path = "export";
	}

	function setupWindow():Void
	{
		window.width = 1280;
		window.height = 720;
		window.fps = 60;
		window.background = 0x00111F;
		window.hardware = true;
		window.vsync = false;
		window.antialiasing = 0;
		window.allowShaders = true;
	}

	function setupSource():Void
	{
		sources.push("source");
	}

	function setupHaxelibs():Void
	{
		var pinned:Map<String, String> = loadPinnedVersions();

		addHaxelib("lime", pinned);
		addHaxelib("openfl", pinned);
		addHaxelib("flixel", pinned);
		addHaxelib("flixel-addons", pinned);
		addHaxelib("flixel-ui", pinned);
		addHaxelib("hscript", pinned);
		addHaxelib("SScript", pinned);

		if (debug)
		{
			addHaxelib("flixel-demos", pinned);
			activeFeatures.push("flixel-demos (debug reference)");
		}

		if (target != HTML5 && envOr("SHARK_DISABLE_DISCORD_RPC", "") != "1")
		{
			addHaxelib("hxdiscord_rpc", pinned);
			activeFeatures.push("Discord Rich Presence");
		}
		else if (envOr("SHARK_DISABLE_DISCORD_RPC", "") == "1")
		{
			buildWarnings.push("hxdiscord_rpc skipped (SHARK_DISABLE_DISCORD_RPC=1) - diagnostic build.");
		}

		if (target == ANDROID)
		{
			addHaxelib("extension-androidtools", pinned);
			activeFeatures.push("Android native tools");
		}

		addHaxelib("polymod", pinned);
		activeFeatures.push("Polymod");

		if ((target == WINDOWS || target == MAC || target == LINUX || target == ANDROID || target == IOS) && envOr("SHARK_DISABLE_HXVLC", "") != "1")
		{
			addHaxelib("hxvlc", pinned);
			activeFeatures.push("Video playback (hxvlc)");
		}
		else if (envOr("SHARK_DISABLE_HXVLC", "") == "1")
		{
			buildWarnings.push("hxvlc skipped (SHARK_DISABLE_HXVLC=1) - diagnostic build.");
		}

		addHaxelib("hxmath", pinned);
		haxedefs.set("HXMATH_USE_OPENFL_STRUCTURES", "");

		addHaxelib("newgrounds", pinned);
		activeFeatures.push("Newgrounds API");

		if (target == ANDROID || target == IOS)
		{
			addHaxelib("astc-compressor", pinned);
			activeFeatures.push("ASTC texture compression (astc-compressor)");
		}

		if (target == LINUX)
		{
			addHaxelib("hxgamemode", pinned);
			activeFeatures.push("Linux GameMode");
		}

		addHaxelib("flxanimate", pinned);

		if (!debug && sharkEnvironment != "production" && envOr("SHARK_SENTRY_DSN", "").length > 0)
		{
			addHaxelib("sentry", pinned);
			activeFeatures.push("Crash reporting (Sentry)");
			validateSentryDsn(envOr("SHARK_SENTRY_DSN", ""));
		}

		if (debug)
		{
			addHaxelib("munit", pinned);
			addHaxelib("mconsole", pinned);
			activeFeatures.push("Unit testing (munit, debug only)");

			if (envOr("SHARK_COVERAGE", "") == "1")
			{
				addHaxelib("mcover", pinned);
				haxeflags.push("--macro mcover.MCover.instrument()");
				activeFeatures.push("Code coverage (mcover)");
			}
		}
	}

	function validateSentryDsn(dsn:String):Void
	{
		var dsnPattern:EReg = ~/^https?:\/\/[a-f0-9]+@[a-zA-Z0-9.\-]+\/[0-9]+$/;

		if (!dsnPattern.match(dsn))
			buildWarnings.push('SHARK_SENTRY_DSN does not look like a valid Sentry DSN - crash reporting may fail to initialize.');
	}

	function loadPinnedVersions():Map<String, String>
	{
		var pinned:Map<String, String> = new Map();
		var path:String = "haxelib_versions.json";

		if (!FileSystem.exists(path))
			return pinned;

		try
		{
			var parsed:Dynamic = Json.parse(File.getContent(path));

			for (field in Reflect.fields(parsed))
				pinned.set(field, Reflect.field(parsed, field));
		}
		catch (e:Dynamic)
		{
			buildWarnings.push('$path exists but could not be parsed - ignoring version pins.');
		}

		return pinned;
	}

	function addHaxelib(name:String, pinned:Map<String, String>):Void
	{
		if (pinned.exists(name))
		{
			haxelibs.push(new Haxelib(name, pinned.get(name)));
			return;
		}

		haxelibs.push(new Haxelib(name));
	}

	function setupAssets():Void
	{
		includeAssets("assets/images", "assets/images");
		includeAssets("assets/data", "assets/data");

		if (FileSystem.exists("assets/sounds") && FileSystem.readDirectory("assets/sounds").length > 0)
			includeAssets("assets/sounds", "assets/sounds");
		else
			buildWarnings.push("assets/sounds is missing or empty - no sound effects or music will be bundled.");

		if (FileSystem.exists("assets/music") && FileSystem.readDirectory("assets/music").length > 0)
			includeAssets("assets/music", "assets/music");

		if (FileSystem.exists("assets/fonts") && FileSystem.readDirectory("assets/fonts").length > 0)
			includeAssets("assets/fonts", "assets/fonts");

		if (FileSystem.exists("assets/shaders") && FileSystem.readDirectory("assets/shaders").length > 0)
			includeAssets("assets/shaders", "assets/shaders");

		setupMods();
	}

	function setupMods():Void
	{
		if (target == HTML5)
			return;

		if (!FileSystem.exists("mods") || !FileSystem.isDirectory("mods"))
			return;

		var entries:Array<String> = FileSystem.readDirectory("mods");

		if (entries.length == 0)
			return;

		var scriptModCount:Int = 0;
		var folderModCount:Int = 0;

		for (entry in entries)
		{
			var fullPath:String = 'mods/$entry';

			if (FileSystem.isDirectory(fullPath))
				folderModCount++;
			else if (StringTools.endsWith(entry, ".hxs"))
				scriptModCount++;
		}

		includeAssets("mods", "mods");
		haxedefs.set("SHARK_HAS_BUNDLED_MODS", "");

		setupPolymodDefines();
		validateBundledMods(entries);
		validateModDependencyGraph(entries);

		activeFeatures.push('Bundled mods ($scriptModCount script, $folderModCount folder)');
		Log.info('Bundled mods folder detected: $scriptModCount .hxs script mod(s), $folderModCount Polymod folder mod(s) - packaging with the app.');
	}

	function validateBundledMods(entries:Array<String>):Void
	{
		for (entry in entries)
		{
			var fullPath:String = 'mods/$entry';

			if (!FileSystem.isDirectory(fullPath))
				continue;

			var manifestPath:String = '$fullPath/modpack.json';

			if (!FileSystem.exists(manifestPath))
			{
				buildWarnings.push('Bundled mod folder "$entry" has no modpack.json - it will not be detected as a mod.');
				continue;
			}

			try
			{
				var manifest:Dynamic = Json.parse(File.getContent(manifestPath));
				var requiredFields:Array<String> = ["title", "description", "modVersion"];

				for (field in requiredFields)
					if (!Reflect.hasField(manifest, field) || Reflect.field(manifest, field) == null)
						buildWarnings.push('Bundled mod "$entry" modpack.json is missing required field "$field".');
			}
			catch (e:Dynamic)
			{
				buildWarnings.push('Bundled mod "$entry" has an invalid modpack.json (not valid JSON).');
			}
		}
	}

	function validateModDependencyGraph(entries:Array<String>):Void
	{
		var folderNames:Array<String> = [for (entry in entries) if (FileSystem.isDirectory('mods/$entry')) entry];

		for (entry in folderNames)
		{
			var manifestPath:String = 'mods/$entry/modpack.json';

			if (!FileSystem.exists(manifestPath))
				continue;

			try
			{
				var manifest:Dynamic = Json.parse(File.getContent(manifestPath));

				if (!Reflect.hasField(manifest, "requiredMods"))
					continue;

				var required:Array<Dynamic> = Reflect.field(manifest, "requiredMods");

				for (dependency in required)
				{
					var dependencyName:String = Std.string(dependency);

					if (folderNames.indexOf(dependencyName) == -1)
						buildWarnings.push('Mod "$entry" requires "$dependencyName", which is not present in mods/ - it will fail to load at runtime.');
				}
			}
			catch (e:Dynamic) {}
		}
	}

	function setupPolymodDefines():Void
	{
		haxedefs.set("POLYMOD_SCRIPT_EXT", "hxs");

		if (debug)
			haxedefs.set("POLYMOD_DEBUG", "");
	}

	function setupLocalization():Void
	{
		var path:String = "assets/data/locales";

		if (!FileSystem.exists(path) || !FileSystem.isDirectory(path))
			return;

		var locales:Array<String> = [];

		for (entry in FileSystem.readDirectory(path))
			if (StringTools.endsWith(entry, ".json"))
				locales.push(Path.withoutExtension(entry));

		if (locales.length == 0)
			return;

		includeAssets(path, "assets/data/locales");
		haxedefs.set("SHARK_LOCALES", locales.join(","));
		haxedefs.set("SHARK_DEFAULT_LOCALE", envOr("SHARK_DEFAULT_LOCALE", locales.indexOf("en") != -1 ? "en" : locales[0]));

		activeFeatures.push('Localization (${locales.length} locale(s): ${locales.join(", ")})');
	}

	function setupFeatureFlags():Void
	{
		var path:String = "assets/data/features.json";

		if (!FileSystem.exists(path))
			return;

		try
		{
			var parsed:Dynamic = Json.parse(File.getContent(path));

			for (field in Reflect.fields(parsed))
			{
				var enabled:Dynamic = Reflect.field(parsed, field);

				if (enabled == true)
				{
					haxedefs.set('SHARK_FEATURE_${field.toUpperCase()}', "");
					activeFeatures.push('Feature flag: $field');
				}
			}
		}
		catch (e:Dynamic)
		{
			buildWarnings.push('$path exists but could not be parsed - no feature flags applied.');
		}
	}

	function setupIcon():Void
	{
		var iconPath:String = "assets/images/icon.png";

		if (sharkEnvironment != "production" && FileSystem.exists("assets/images/icon_dev.png"))
		{
			iconPath = "assets/images/icon_dev.png";
			activeFeatures.push("Dev icon variant");
		}

		icons.push(new Icon(iconPath));
	}

	function setupDefines():Void
	{
		if (!debug)
		{
			haxedefs.set("FLX_NO_DEBUG", "");
			haxedefs.set("FLX_NO_FOCUS_LOST_SCREEN", "");
		}

		haxedefs.set("SHARK_VERSION", meta.version);
		haxedefs.set("SHARK_BUILD_NUMBER", meta.buildNumber);
		haxedefs.set("SHARK_COMMIT", resolveGitCommit());
		haxedefs.set("SHARK_ENVIRONMENT", sharkEnvironment);
		haxedefs.set("SHARK_BUILD_TIMESTAMP", Std.string(Std.int(Date.now().getTime() / 1000)));

		if (envOr("CI", "") == "true" || envOr("GITHUB_ACTIONS", "") == "true")
			haxedefs.set("SHARK_CI_BUILD", "");

		var sentryDsn:String = envOr("SHARK_SENTRY_DSN", "");

		if (sentryDsn.length > 0)
			haxedefs.set("SHARK_SENTRY_DSN", sentryDsn);
		else if (sharkEnvironment == "production")
			buildWarnings.push("No SHARK_SENTRY_DSN set for a production build - crash reporting will be disabled.");
	}

	function setupOptimizations():Void
	{
		if (!debug)
		{
			haxeflags.push("-dce full");
			haxeflags.push("-D no-traces");
			haxeflags.push("-D analyzer-optimize");
		}
	}

	function setupWindows():Void
	{
		window.width = 1280;
		window.height = 720;
		window.resizable = true;
		window.background = 0x00111F;

		architectures = [Architecture.X64];

		haxedefs.set("SHARK_PLATFORM", "windows");

		checkWindowsToolchain();
		applyWindowsGdiWorkaroundIfRequested();

		if (!debug)
		{
			haxeflags.push("-dce full");
			haxeflags.push("-D no-traces");

			if (envOr("SHARK_SIGN_WINDOWS", "") != "1")
			{
				buildWarnings.push("SHARK_SIGN_WINDOWS is not set to 1 - the Windows build will not be code-signed.");
			}
			else
			{
				var certPath:String = envOr("SHARK_WINDOWS_CERT_PATH", "");

				if (certPath.length == 0 || !FileSystem.exists(certPath))
					buildWarnings.push('SHARK_SIGN_WINDOWS=1 but SHARK_WINDOWS_CERT_PATH ("${certPath}") does not point to an existing file - signing will fail.');
			}
		}

		cleanIfRequested("windows");
	}

	function setupAndroid():Void
	{
		window.orientation = LANDSCAPE;
		window.fullscreen = true;
		window.hardware = true;

		architectures = [Architecture.ARMV7, Architecture.ARM64];

		haxedefs.set("SHARK_PLATFORM", "android");
		haxedefs.set("FLX_NO_NATIVE_CURSOR", "");
		haxedefs.set("FLX_NO_SOUND_TRAY", "");

		var permissions:Array<String> = [
			"android.permission.INTERNET",
			"android.permission.WRITE_EXTERNAL_STORAGE",
			"android.permission.READ_EXTERNAL_STORAGE",
			"android.permission.RECORD_AUDIO",
			"android.permission.READ_MEDIA_IMAGES",
			"android.permission.READ_MEDIA_AUDIO",
			"android.permission.FOREGROUND_SERVICE"
		];

		config.set("android.permissions", permissions.join(" "));
		config.set("android.target-sdk-version", "35");
		config.set("android.minimum-sdk-version", "21");
		config.set("android.install-location", "auto");
		config.set("android.window-soft-input-mode", "adjustResize");
		config.set("android.version-code", meta.buildNumber);

		if (!debug)
		{
			var keystoreProfile:String = envOr("SHARK_KEYSTORE_PROFILE", "default");
			var keystorePathKey:String = keystoreProfile == "default" ? "SHARK_KEYSTORE_PATH" : 'SHARK_KEYSTORE_PATH_${keystoreProfile.toUpperCase()}';

			config.set("android.certificate-path", envOr(keystorePathKey, "Certificates/android.keystore"));
			config.set("android.certificate-password", envOr("SHARK_KEYSTORE_PASSWORD", "android"));
			config.set("android.certificate-alias", envOr("SHARK_KEYSTORE_ALIAS", "android"));
			config.set("android.certificate-alias-password", envOr("SHARK_KEYSTORE_ALIAS_PASSWORD", "android"));

			if (!FileSystem.exists(config.get("android.certificate-path")))
				buildWarnings.push('Android keystore not found at "${config.get("android.certificate-path")}" - the release build will fail to sign.');
		}
	}

	function setupIOS():Void
	{
		window.orientation = LANDSCAPE;
		window.fullscreen = true;

		haxedefs.set("SHARK_PLATFORM", "ios");
		haxedefs.set("FLX_NO_NATIVE_CURSOR", "");
		haxedefs.set("FLX_NO_SOUND_TRAY", "");

		config.set("ios.deployment", "12.0");
		config.set("ios.device", "universal");
		config.set("ios.extension", "false");
		config.set("ios.build-number", meta.buildNumber);

		if (!debug && envOr("SHARK_IOS_TEAM_ID", "").length == 0)
			buildWarnings.push("SHARK_IOS_TEAM_ID is not set - Xcode signing may require manual configuration.");
	}

	function setupHTML5():Void
	{
		window.resizable = true;
		window.allowHighDPI = true;
		window.background = 0x00111F;

		haxedefs.set("SHARK_PLATFORM", "html5");

		config.set("html5.title", APP_TITLE);

		if (envOr("SHARK_PWA", "1") == "1")
		{
			writePwaManifest();
			activeFeatures.push("PWA manifest");
		}
	}

	function writePwaManifest():Void
	{
		var manifestPath:String = "assets/data/manifest.webmanifest";

		var manifest:Dynamic = {
			name: APP_TITLE,
			short_name: APP_TITLE,
			start_url: "./",
			display: "standalone",
			background_color: "#00111F",
			theme_color: "#00111F",
			icons: [{src: "assets/images/icon.png", sizes: "512x512", type: "image/png"}]
		};

		try
		{
			if (!FileSystem.exists("assets/data"))
				FileSystem.createDirectory("assets/data");

			File.saveContent(manifestPath, Json.stringify(manifest, null, "\t"));
		}
		catch (e:Dynamic)
		{
			buildWarnings.push("Failed to write PWA manifest - HTML5 build will not be installable.");
		}
	}

	function setupLinux():Void
	{
		window.width = 1280;
		window.height = 720;
		window.resizable = true;
		window.background = 0x00111F;

		architectures = [Architecture.X64];

		haxedefs.set("SHARK_PLATFORM", "linux");

		cleanIfRequested("linux");
	}

	function setupMac():Void
	{
		window.width = 1280;
		window.height = 720;
		window.resizable = true;
		window.background = 0x00111F;

		architectures = [Architecture.X64];

		haxedefs.set("SHARK_PLATFORM", "mac");

		if (!debug && envOr("SHARK_NOTARIZE_MAC", "") != "1")
			buildWarnings.push("SHARK_NOTARIZE_MAC is not set to 1 - the macOS build will not be notarized.");

		cleanIfRequested("mac");
	}

	function checkWindowsToolchain():Void
	{
		try
		{
			var process = new sys.io.Process("where", ["cl"]);
			var exitCode:Int = process.exitCode();
			process.close();

			if (exitCode != 0)
				buildWarnings.push("cl.exe (MSVC compiler) was not found on PATH - the native build will fail. Make sure Visual Studio Build Tools are installed and this is running from a Developer Command Prompt (or that vcvarsall/setup-msvc has run first).");
		}
		catch (e:Dynamic)
		{
			buildWarnings.push("Could not check for cl.exe on PATH (the `where` command failed to run) - skipping MSVC toolchain check.");
		}
	}

	function applyWindowsGdiWorkaroundIfRequested():Void
	{
		if (envOr("SHARK_ATTEMPT_GDI_FIX", "") != "1")
			return;

		haxedefs.set("WIN32_LEAN_AND_MEAN", "");
		haxedefs.set("NOMINMAX", "");
		haxedefs.set("NOGDI", "");

		buildWarnings.push("SHARK_ATTEMPT_GDI_FIX=1 is active - defining NOGDI/WIN32_LEAN_AND_MEAN/NOMINMAX to test a known windows.h \"ERROR\" macro collision (see LogStyle_Impl_.h build failures). This is experimental: NOGDI excludes all GDI declarations from windows.h and could break window/OpenGL context creation if Lime's native backend needs them - verify the app still renders correctly before relying on this.");
	}

	function cleanIfRequested(platformFolder:String):Void
	{
		if (envOr("SHARK_CLEAN_BUILD", "") != "1")
			return;

		var exportPath:String = 'export/$platformFolder';

		if (FileSystem.exists(exportPath))
		{
			Log.info('SHARK_CLEAN_BUILD=1 -> removing $exportPath before build');
			deleteRecursive(exportPath);
		}
	}

	function deleteRecursive(path:String):Void
	{
		if (!FileSystem.exists(path))
			return;

		if (FileSystem.isDirectory(path))
		{
			for (entry in FileSystem.readDirectory(path))
				deleteRecursive('$path/$entry');

			FileSystem.deleteDirectory(path);
		}
		else
		{
			FileSystem.deleteFile(path);
		}
	}

	function setupDevMode():Void
	{
		if (sharkEnvironment != "dev")
			return;

		haxedefs.set("SHARK_DEV_MODE", "");

		meta.title = '$APP_TITLE (dev)';
		window.background = 0xFF2A0A0A;

		Log.info('Environment "dev" (branch "$gitBranch") - SHARK_DEV_MODE enabled (dev-only window tint, title suffix).');
	}

	function setupStagingMode():Void
	{
		if (sharkEnvironment != "staging")
			return;

		haxedefs.set("SHARK_STAGING_MODE", "");

		meta.title = '$APP_TITLE (staging)';
		window.background = 0xFF1A2A00;

		Log.info('Environment "staging" (branch "$gitBranch") - SHARK_STAGING_MODE enabled.');
	}

	function setupProductionMode():Void
	{
		if (sharkEnvironment != "production")
			return;

		haxedefs.set("SHARK_PRODUCTION", "");

		var checklist:Array<String> = [];
		var failures:Array<String> = [];

		checkProductionItem(checklist, failures, "config.json present", FileSystem.exists("assets/data/config.json"), !debug);
		checkProductionItem(checklist, failures, "VERSION format valid", isValidVersionFormat(meta.version), !debug);
		checkProductionItem(checklist, failures, "no leftover dev define", !haxedefs.exists("SHARK_DEV_MODE"), false);
		checkProductionItem(checklist, failures, "working tree clean (no uncommitted changes)", isWorkingTreeClean(), false);
		checkProductionItem(checklist, failures, "no merge conflict markers in source/", !hasMergeConflictMarkers(), true);
		checkProductionItem(checklist, failures, 'version "${meta.version}" has a matching git tag', hasMatchingGitTag(meta.version), false);
		checkProductionItem(checklist, failures, 'CHANGELOG.md mentions "${meta.version}"', changelogMentionsVersion(meta.version), false);
		checkProductionItem(checklist, failures, "no broken mod folders (missing _polymod_meta.json)", !hasIncompleteModFolders(), false);
		checkProductionItem(checklist, failures, "no unresolved setup warnings", buildWarnings.length == 0, false);
		checkProductionItem(checklist, failures, "config.json network.chatEndpoint is set", configHasChatEndpoint(), false);

		if (target == ANDROID && !debug)
		{
			var keystorePath:String = envOr("SHARK_KEYSTORE_PATH", "Certificates/android.keystore");
			checkProductionItem(checklist, failures, 'Android keystore exists ($keystorePath)', FileSystem.exists(keystorePath), true);
		}

		if (!debug)
			checklist.push("[OK] release optimizations active (see setupOptimizations)");

		Log.info('Production checklist (branch "$MAIN_BRANCH_NAME"):\n  ' + checklist.join("\n  "));

		if (failures.length > 0 && !debug)
		{
			Log.error('Production build blocked - fix the following before building from $MAIN_BRANCH_NAME:\n  ' + failures.join("\n  "));
			Sys.exit(1);
		}
	}

	function checkProductionItem(checklist:Array<String>, failures:Array<String>, label:String, passed:Bool, isBlocking:Bool):Void
	{
		if (passed)
		{
			checklist.push('[OK] $label');
			return;
		}

		if (isBlocking)
		{
			checklist.push('[FAIL] $label');
			failures.push(label);
		}
		else
		{
			checklist.push('[WARN] $label');
		}
	}

	function isWorkingTreeClean():Bool
	{
		try
		{
			var process = new sys.io.Process("git", ["status", "--porcelain"]);
			var output:String = StringTools.trim(process.stdout.readAll().toString());
			process.close();

			return output.length == 0;
		}
		catch (e:Dynamic)
		{
			return true;
		}
	}

	function hasMergeConflictMarkers():Bool
	{
		return directoryContainsMarker("source", "<<<<<<< ");
	}

	function directoryContainsMarker(path:String, marker:String):Bool
	{
		if (!FileSystem.exists(path))
			return false;

		for (entry in FileSystem.readDirectory(path))
		{
			var fullPath:String = '$path/$entry';

			if (FileSystem.isDirectory(fullPath))
			{
				if (directoryContainsMarker(fullPath, marker))
					return true;

				continue;
			}

			if (!StringTools.endsWith(entry, ".hx") && !StringTools.endsWith(entry, ".hxp"))
				continue;

			try
			{
				var content:String = File.getContent(fullPath);

				if (content.indexOf(marker) != -1)
					return true;
			}
			catch (e:Dynamic) {}
		}

		return false;
	}

	function hasMatchingGitTag(version:String):Bool
	{
		try
		{
			var process = new sys.io.Process("git", ["tag", "--list"]);
			var output:String = process.stdout.readAll().toString();
			process.close();

			return output.indexOf(version) != -1 || output.indexOf('v$version') != -1;
		}
		catch (e:Dynamic)
		{
			return true;
		}
	}

	function changelogMentionsVersion(version:String):Bool
	{
		if (!FileSystem.exists("CHANGELOG.md"))
			return true;

		try
		{
			var content:String = File.getContent("CHANGELOG.md");
			return content.indexOf(version) != -1;
		}
		catch (e:Dynamic)
		{
			return true;
		}
	}

	function generateChangelogEntry():Void
	{
		if (envOr("SHARK_AUTO_CHANGELOG", "0") != "1" || debug)
			return;

		if (!FileSystem.exists("CHANGELOG.md"))
			return;

		try
		{
			var content:String = File.getContent("CHANGELOG.md");

			if (content.indexOf(meta.version) != -1)
				return;

			var lastTag:String = resolveLastGitTag();
			var commits:Array<String> = collectCommitsSince(lastTag);

			if (commits.length == 0)
				return;

			var entryLines:Array<String> = ['## [${meta.version}] - ${formatDate(Date.now())}', ""];

			for (commit in commits)
				entryLines.push('- $commit');

			entryLines.push("");

			var updated:String = entryLines.join("\n") + content;

			File.saveContent("CHANGELOG.md", updated);
			activeFeatures.push('Changelog entry generated (${commits.length} commit(s))');
		}
		catch (e:Dynamic)
		{
			buildWarnings.push("Failed to write CHANGELOG.md auto-entry.");
		}
	}

	function resolveLastGitTag():String
	{
		try
		{
			var process = new sys.io.Process("git", ["describe", "--tags", "--abbrev=0"]);
			var output:String = StringTools.trim(process.stdout.readAll().toString());
			process.close();
			return output;
		}
		catch (e:Dynamic)
		{
			return "";
		}
	}

	function collectCommitsSince(tag:String):Array<String>
	{
		var range:String = tag.length > 0 ? '$tag..HEAD' : "HEAD";

		try
		{
			var process = new sys.io.Process("git", ["log", range, "--pretty=format:%s"]);
			var output:String = StringTools.trim(process.stdout.readAll().toString());
			process.close();

			if (output.length == 0)
				return [];

			return output.split("\n");
		}
		catch (e:Dynamic)
		{
			return [];
		}
	}

	function syncReadmeVersionBadge():Void
	{
		if (envOr("SHARK_SYNC_README", "0") != "1")
			return;

		if (!FileSystem.exists("README.md"))
			return;

		try
		{
			var content:String = File.getContent("README.md");
			var badgePattern:EReg = ~/version-[0-9]+\.[0-9]+\.[0-9]+-([a-zA-Z]+)/;

			if (!badgePattern.match(content))
			{
				buildWarnings.push("SHARK_SYNC_README=1 but no version badge pattern found in README.md.");
				return;
			}

			var color:String = badgePattern.matched(1);
			var updated:String = badgePattern.replace(content, 'version-${meta.version}-$color');

			if (updated == content)
				return;

			File.saveContent("README.md", updated);
			activeFeatures.push("README version badge synced");
		}
		catch (e:Dynamic)
		{
			buildWarnings.push("Failed to sync README.md version badge.");
		}
	}

	function writePostBuildHooks():Void
	{
		if (envOr("SHARK_WRITE_POSTBUILD_HOOK", "1") != "1")
			return;

		var platformFolder:String = Std.string(target).toLowerCase();
		var hookDir:String = "build_hooks";

		try
		{
			if (!FileSystem.exists(hookDir))
				FileSystem.createDirectory(hookDir);

			var shellScript:String = "#!/bin/sh\n" +
				"set -e\n" +
				'ARCHIVE_NAME="shark-${meta.version}-$platformFolder.zip"\n' +
				'cd "export/$platformFolder"\n' +
				'zip -r "../../$ARCHIVE_NAME" . -x ".*"\n' +
				'echo "Created $ARCHIVE_NAME"\n';

			File.saveContent('$hookDir/post_build_$platformFolder.sh', shellScript);

			var batScript:String = "@echo off\n" +
				'set ARCHIVE_NAME=shark-${meta.version}-$platformFolder.zip\n' +
				'cd export\\$platformFolder\n' +
				"powershell Compress-Archive -Path * -DestinationPath ..\\..\\%ARCHIVE_NAME% -Force\n" +
				"echo Created %ARCHIVE_NAME%\n";

			File.saveContent('$hookDir/post_build_$platformFolder.bat', batScript);

			activeFeatures.push('Post-build packaging hooks written ($hookDir)');
		}
		catch (e:Dynamic)
		{
			buildWarnings.push("Failed to write post-build packaging hooks.");
		}
	}

	function hasIncompleteModFolders():Bool
	{
		if (!FileSystem.exists("mods") || !FileSystem.isDirectory("mods"))
			return false;

		for (entry in FileSystem.readDirectory("mods"))
		{
			var fullPath:String = 'mods/$entry';

			if (!FileSystem.isDirectory(fullPath))
				continue;

			if (!FileSystem.exists('$fullPath/_polymod_meta.json'))
				return true;
		}

		return false;
	}

	function maybeCreateGitTag():Void
	{
		if (sharkEnvironment != "production" || debug || envOr("SHARK_AUTO_TAG", "") != "1")
			return;

		if (hasMatchingGitTag(meta.version))
			return;

		try
		{
			var process = new sys.io.Process("git", ["tag", 'v${meta.version}']);
			process.exitCode();
			process.close();

			Log.info('Created git tag v${meta.version}');
		}
		catch (e:Dynamic)
		{
			buildWarnings.push('SHARK_AUTO_TAG=1 but failed to create git tag v${meta.version}.');
		}
	}

	function writeBuildInfo():Void
	{
		var info:Dynamic = {
			title: meta.title,
			version: meta.version,
			buildNumber: meta.buildNumber,
			commit: haxedefs.get("SHARK_COMMIT"),
			branch: gitBranch,
			environment: sharkEnvironment,
			target: Std.string(target),
			debug: debug,
			features: activeFeatures,
			buildPhases: buildPhases,
			generatedAt: Std.int(Date.now().getTime() / 1000)
		};

		try
		{
			if (!FileSystem.exists("assets/data"))
				FileSystem.createDirectory("assets/data");

			File.saveContent("assets/data/build_info.json", Json.stringify(info, null, "\t"));
		}
		catch (e:Dynamic)
		{
			buildWarnings.push("Failed to write assets/data/build_info.json - runtime version info will be unavailable.");
		}
	}

	function writeBuildReport():Void
	{
		var lines:Array<String> = [];

		lines.push('Shark build report - ${Date.now().toString()}');
		lines.push('Version: ${meta.version} (build ${meta.buildNumber})');
		lines.push('Branch: $gitBranch, environment: $sharkEnvironment, target: $target, mode: ${debug ? "debug" : "release"}');
		lines.push("");

		if (target == WINDOWS)
		{
			lines.push("Known Windows issue: a windows.h \"ERROR\" macro collision can break the native build inside");
			lines.push("Flixel/OpenFL generated headers (e.g. LogStyle_Impl_.h) with C2059/C2238 errors. To bisect which");
			lines.push("native dependency triggers it, retry with SHARK_DISABLE_HXVLC=1 or SHARK_DISABLE_DISCORD_RPC=1.");
			lines.push("To experimentally test the documented NOGDI fix, retry with SHARK_ATTEMPT_GDI_FIX=1 (see warnings).");
			lines.push("");
		}

		lines.push("Build phases:");

		for (phase in buildPhases)
			lines.push('  ${phase.phase}: ${formatDecimal(phase.ms, 1)}ms');

		lines.push("");

		if (activeFeatures.length > 0)
		{
			lines.push("Active features:");

			for (feature in activeFeatures)
				lines.push('  - $feature');

			lines.push("");
		}

		if (buildWarnings.length > 0)
		{
			lines.push('Warnings (${buildWarnings.length}):');

			for (warning in buildWarnings)
				lines.push('  - $warning');
		}
		else
		{
			lines.push("No warnings.");
		}

		try
		{
			File.saveContent("build_report.log", lines.join("\n"));
		}
		catch (e:Dynamic) {}
	}

	function sendDiscordNotification(message:String):Void
	{
		var webhookUrl:String = envOr("SHARK_DISCORD_WEBHOOK_URL", "");

		if (webhookUrl.length == 0 || envOr("SHARK_NOTIFY_DISCORD", "0") != "1")
			return;

		try
		{
			var parsedUrl = parseUrl(webhookUrl);
			var payload:String = Json.stringify({content: message});
			var request:String = 'POST ${parsedUrl.path} HTTP/1.1\r\n' +
				'Host: ${parsedUrl.host}\r\n' +
				'Content-Type: application/json\r\n' +
				'Content-Length: ${Bytes.ofString(payload).length}\r\n' +
				'Connection: close\r\n\r\n' + payload;

			var socket = new SSLSocket();
			socket.setTimeout(5.0);
			socket.connect(new Host(parsedUrl.host), parsedUrl.port);
			socket.write(request);
			socket.close();

			activeFeatures.push("Discord build notification sent");
		}
		catch (e:Dynamic)
		{
			buildWarnings.push("Failed to send Discord webhook notification.");
		}
	}

	function resolveGitCommit():String
	{
		try
		{
			var process = new sys.io.Process("git", ["rev-parse", "--short", "HEAD"]);
			var output:String = StringTools.trim(process.stdout.readAll().toString());
			process.close();

			return output.length > 0 ? output : "unknown";
		}
		catch (e:Dynamic)
		{
			return "unknown";
		}
	}

	function resolveGitBranch():String
	{
		try
		{
			var process = new sys.io.Process("git", ["rev-parse", "--abbrev-ref", "HEAD"]);
			var output:String = StringTools.trim(process.stdout.readAll().toString());
			var exitCode:Int = process.exitCode();
			process.close();

			if (exitCode != 0)
			{
				isGitAvailable = false;
				return "unknown";
			}

			return output.length > 0 ? output : "unknown";
		}
		catch (e:Dynamic)
		{
			isGitAvailable = false;
			return "unknown";
		}
	}

	function resolveBuildNumber():String
	{
		var path:String = ".build_number";
		var current:Int = 0;

		try
		{
			if (FileSystem.exists(path))
				current = Std.parseInt(StringTools.trim(File.getContent(path)));

			if (current == null)
				current = 0;
		}
		catch (e:Dynamic)
		{
			current = 0;
		}

		current++;

		try
		{
			File.saveContent(path, Std.string(current));
		}
		catch (e:Dynamic) {}

		return Std.string(current);
	}
}
